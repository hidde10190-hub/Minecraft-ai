# Bot container: virtual X display + noVNC so the swarm is visible in the browser.
FROM node:20-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Xvfb (virtual display), x11vnc (exposes it as VNC), websockify+novnc (VNC->WebSocket->browser)
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc novnc websockify supervisor xterm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /bot
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build:bot || true

# Supervisor config: Xvfb on :1, x11vnc on :5900, websockify/noVNC on :6080, bot process.
# The config lives in supervisord.conf (copied in via "COPY . ." above) and is placed
# where Debian's supervisord looks for configs by default.
RUN mkdir -p /etc/supervisor/conf.d \
    && cp /bot/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 6080 5900
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
