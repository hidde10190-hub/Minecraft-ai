# ==============================================================================
# MINECRAFT AI CONTROLLER & MULTI-AGENT SWARM ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Generated: 2026-10-17T07:58:04.423Z
# Live Configuration synced from Dashboard
# ==============================================================================

# 1. MINECRAFT SERVER CONNECTION
MINECRAFT_SERVER_HOST="host.docker.internal"
MINECRAFT_SERVER_PORT=25565
MINECRAFT_AUTO_RECONNECT=true
MINECRAFT_RECONNECT_DELAY_MS=3000
MINECRAFT_VERSION="26.2"

# 2. BOT USERNAMES & SWARM CONFIGURATION
BOT_COUNT=1
BOT_PRIMARY_USERNAME="Gemini"
BOT_USERNAMES="Gemini,Builder-Bot,Miner-Bot,Scout-Bot,Guard-Bot"
BOT_ROLES="Assistant,Builder,Miner,Scout,Guard"
BOT_IPC_PORTS="8080,8081,8082,8083,8084"
BOT_TEAM_NAME="AI-Swarm"

# 3. AI PROVIDER SELECTION & API KEYS
AI_PROVIDER="auto"
AI_PROVIDER_PRIORITY="nvidia,gemini,groq,openrouter,ollama"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# NVIDIA NIM (Llama 3.2 11B Vision is the standard model)
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"
NVIDIA_BASE_URL=""

# Groq
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_HTTP_REFERER="https://github.com/hidde10190-hub/Minecraft-ai"

# Ollama local inference
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5vl:3b"
OLLAMA_NUM_CTX=131072
OLLAMA_VISION_MODEL="moondream:1.8b"

# Other Providers
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
TOGETHER_API_KEY=""
TOGETHER_MODEL=""
TOGETHER_BASE_URL="https://api.together.xyz/v1"
XAI_API_KEY=""
XAI_MODEL="grok-2-latest"
XAI_BASE_URL="https://api.x.ai/v1"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
FIREWORKS_API_KEY=""
FIREWORKS_MODEL=""
FIREWORKS_BASE_URL="https://api.fireworks.ai/inference/v1"
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=""
SAMBANOVA_API_KEY=""
SAMBANOVA_MODEL=""
DEEPINFRA_API_KEY=""
DEEPINFRA_MODEL=""
OVHCLOUD_API_KEY=""
OVHCLOUD_MODEL=""
CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_MODEL=""
CUSTOM_OPENAI_BASE_URL="http://localhost:8000/v1"

# Autonomy & System
ENABLE_BUILTIN_OFFLINE_FALLBACK=true
AI_TICK_RATE_MS=50
AI_AUTONOMY_ENABLED=true
AI_AUTONOMY_INTERVAL_SECONDS=3

# In-Game Chat Perception
CHAT_LISTEN_ENABLED=true
CHAT_AUTO_REPLY=true
CHAT_REQUIRE_PREFIX=false
CHAT_COMMAND_PREFIX="!"
CHAT_IGNORE_OTHER_BOTS=true
CHAT_PROACTIVE_ANNOUNCE=true
CHAT_HUMANIZE_DELAY="natural"
CHAT_PERSONA_TONE="assistant"
RADAR_SCAN_RADIUS_BLOCKS=64
RADAR_FOV_DEGREES=360

# Dashboard & Studio
DASHBOARD_PORT=3000
APP_URL=""
DASHBOARD_THEME="midnight"
DASHBOARD_SOUND_ALERTS=true
DASHBOARD_DEFAULT_TAB="workbench"
LITEMATICA_BUILD_SPEED_MS=150
LITEMATICA_AUTO_HOTBAR_SWITCH=true
MAP_EXPLORE_RADIUS_CHUNKS=8
